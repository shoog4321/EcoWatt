SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=...             # the same publishable/anon key the Flutter app uses
SUPABASE_SERVICE_KEY=...          # server only. NEVER put this in the Flutter app or in git
ADMIN_TOKEN=change-me-long-random

ENGINE_MODE=gpu_service           # gpu_service = your advice_engine.py behind HTTP (recommended); openai = vLLM
LLM_BASE_URL=                     # GPU host URL (e.g. the ngrok URL); can also be set via PUT /admin/llm-endpoint
LLM_API_KEY=                      # must equal GPU_API_KEY on the GPU service
LLM_TIMEOUT_S=300
CORS_ORIGINS=*                    # restrict for production
